<table class="usa-table usa-table--borderless usa-table--stacked">
    <thead>
        <tr><th scope="col">{{ _('committee'     ) }}</th>
            <th scope="col">{{ _('seat'          ) }}</th>
            <th scope="col">{{ _('start'         ) }}</th>
            <th scope="col">{{ _('end'           ) }}</th>
            <th scope="col">{{ _('status'        ) }}</th>
            <th scope="col">{{ _('appointed_by'  ) }}</th>
            <th scope="col">{{ _('name'          ) }}</th>
        </tr>
    </thead>
    <tbody>
    {% for row in data %}
    <tr><td><a href="{{ uri('committees.members', { committee_id: row.committee_id }) }}" class="usa-link">
                {{ row.committee_code ?? row.committee_name }}
            </a>
        </td>
        <td><a href="{{ uri('seats.view', { seat_id: row.seat_id }) }}" class="usa-link">
                {{ row.seat_name }}
            </a>
        </td>
        {% if row.seat_type=='termed' %}
        <td>{{ row.term_startDate ? row.term_startDate|date(DATE_FORMAT) : '' }}</td>
        <td>{{ row.term_endDate   ? row.term_endDate  |date(DATE_FORMAT) : '' }}</td>
        {% else %}
        <td>{{ row.member_startDate ? row.member_startDate|date(DATE_FORMAT) : '' }}</td>
        <td>{{ row.member_endDate   ? row.member_endDate  |date(DATE_FORMAT) : '' }}</td>
        {% endif %}

        {% set colors = { 'filled':'base', 'termEndsSoon':'accent-warm-dark', 'carryOver':'accent-warm-dark', 'vacant':'secondary-dark' } %}
        <td><span class="usa-tag bg-{{ colors[row.status] }}">{{ _(row.status) }}</span>
            {% if row.status=='vacant' %}since {{ row.last_member_endDate|date(DATE_FORMAT) }}{% endif %}
        </td>

        <td>{{ row.appointer_name }}{{ row.seat_voting ? ' (Voting)' : '' }}</td>
        <td>{% if row.member_person_id %}
            <a href="{{ uri('people.view', { person_id: row.member_person_id }) }}" class="usa-link">
                {{ row.member_firstname }} {{ row.member_lastname }}
            </a>
            {% endif %}
        </td>
    </tr>
    {% endfor %}
    </tbody>
</table>
