{% extends "html/layouts/default.twig" %}

{% block content %}
<section>
    <header>
        <h1><a href="{{ uri('departments.index') }}">{{ _(['department', 'departments', 10]) }}</a></h1>
        <h2>{{ department.name }}</h2>
    </header>

    <table>
    <thead>
    <tr><th>{{ _('committee') }}</th>
        <th>{{ _(['liaison', 'liaisons', 10]) }}</th>
    </tr>
    <tbody>
        {% for c in department.committees %}
        <tr><td><a href="{{ uri('committees.info', { committee_id: c.id }) }}">
                    {{ c.name }}
                </a>
            </td>
            <td>{% for l in c.liaisons %}
                {{ l.firstname }} {{ l.lastname }}{% if not loop.last %}, {% endif %}
                {% endfor %}
            </td>
        </tr>
        {% else %}
        <tr><td>No committees found.</td></tr>
        {% endfor %}
    </tbody>
    </table>

    {% if isAllowed('users', 'view') %}
    <section>
        <header><h3>Users</h3></header>
        {% if department.users|length > 0 %}
        <ul>{% for u in department.users %}
            <li><a href="{{ uri('people.view', { person_id: u.id } ) }}">{{ u.fullname }}</a></li>
            {% endfor %}
        </ul>
        {% else %}
        <p>No users found for this department.</p>
        {% endif %}
    </section>
    {% endif %}
</section>
{% endblock %}
