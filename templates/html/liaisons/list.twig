{% extends "html/layouts/default.twig" %}
{% import  "html/macros/forms.twig" as forms %}
{% block content %}
<section>
    <header>
        <h1>{{ _(['liaison', 'liaisons', 10]) }}</h1>
    </header>
    <form         class="usa-form" method="get">
        <fieldset class="usa-fieldset">
            {{ forms.field_select('type',         'type',         _('type'),      type,         types     , false, { onchange:'this.form.submit();' }) }}
            {{ forms.field_select('committee_id', 'committee_id', _('committee'), committee_id, committees, false, { onchange:'this.form.submit();' }) }}
            {{ forms.field_select('status',       'status',       _('status'   ), status,       statuses  , false, { onchange:'this.form.submit();' }) }}
            {{ forms.button('submit', _('search'), 'search') }}
            {{ forms.actionLink(uri('liaisons.index'), _('reset'), 'cancel') }}
        </fieldset>
    </form>

    {% if actionLinks is defined %}
    {{ include('html/partials/actionLinks.twig') }}
    {% endif %}

    <table  class="usa-table usa-table--borderless usa-table--stacked">
        <thead>
            <tr><th>{{ _('committee'   ) }}</th>
                <th>{{ _('type'        ) }}</th>
                <th>{{ _('name'        ) }}</th>
                {% if isAllowed('people', 'viewContactInfo') %}
                <th>{{ _('email'   ) }}</th>
                <th>{{ _('phone'   ) }}</th>
                {% endif %}
                <th>{{ _('status'      ) }}</th>
            </tr>
        </thead>
        <tbody>
            {% for row in data %}
            <tr><td><a class="usa-link" href="{{ uri('committees.info', { committee_id: row.committee_id}) }}">
                        {{ row.committee_code ?? row.committee }}
                    </a>
                </td>
                <td>{{ row.type ? _(row.type): '' }}</td>
                <td>{% if row.person_id %}
                    <a href="{{ uri('people.view', { person_id: row.person_id }) }}" class="usa-link">{{ row.firstname }} {{ row.lastname }}</a>
                    {% endif %}
                </td>
                {% if isAllowed('people', 'viewContactInfo') %}
                <td>{{ row.email }}</td>
                <td>{{ row.phone }}</td>
                {% endif %}
                <td>{{ row.status }}</td>
            {% endfor %}
        </tbody>
    </table>
</section>

{% endblock %}
